build libzcat_gles.a: CXX_STATIC_LIBRARY_LINKER__zcat_gles_Release CMakeFiles/zcat_gles.dir/src/zgl_context.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_raster.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_texture.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_texture_compressed.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_draw.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_fastmath.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_simd.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_api_common.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_api_state.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_api_buffer.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_api_texture.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_api_framebuffer.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_api_program.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_api_draw.cpp.o CMakeFiles/zcat_gles.dir/src/zgl_api_stubs.cpp.o CMakeFiles/zcat_gles.dir/src/glsl/glsl_types.cpp.o CMakeFiles/zcat_gles.dir/src/glsl/glsl_lexer.cpp.o CMakeFiles/zcat_gles.dir/src/glsl/glsl_parser.cpp.o CMakeFiles/zcat_gles.dir/src/glsl/glsl_program.cpp.o CMakeFiles/zcat_gles.dir/src/glsl/glsl_eval.cpp.o CMakeFiles/zcat_gles.dir/src/glsl/glsl_jit.cpp.o || libsljit.a
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG
  OBJECT_DIR = CMakeFiles/zcat_gles.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = CMakeFiles/zcat_gles.dir/zcat_gles.pdb
  TARGET_FILE = libzcat_gles.a
  TARGET_PDB = libzcat_gles.pdb


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/zcat-gles-push/build-push && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/user/zcat-gles-push/build-push && /usr/bin/cmake --regenerate-during-build -S/home/user/zcat-gles-push -B/home/user/zcat-gles-push/build-push
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build sljit: phony libsljit.a

build zcat_gles: phony libzcat_gles.a

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: /home/user/zcat-gles-push/build-push

build all: phony libsljit.a libzcat_gles.a

